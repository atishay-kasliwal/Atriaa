# Optional local synthetic SQLite path; default var/atria-demo.sqlite3.
ATRIA_DB_PATH=

# Optional future Supabase connection. Keep values in ignored .env.local.
# Publishable keys allow configured client reads, not schema administration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional backend-only Gemini credential; no API integration is implemented yet.
GEMINI_API_KEY=
