{
  "name": "atria-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/worker.mjs && node --check public/app.js && node --check src/client.mjs && node --check src/motion.mjs && npm test",
    "db:local": "wrangler d1 migrations apply atria-waitlist --local",
    "db:remote": "wrangler d1 migrations apply atria-waitlist --remote",
    "deploy": "npm run check && wrangler deploy",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
