{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atria-landing",
  "account_id": "5a4ff8745582949139ddfd36ee1ae3e9",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atria-waitlist",
      "database_id": "08cb6135-41cd-490c-ab42-43446f4f1a52",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SIGNUP_LIMITER",
      "namespace_id": "2026101901",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "public",
      "css",
      "src",
      "scripts"
    ]
  }
}
