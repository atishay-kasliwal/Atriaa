{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atria-landing",
  "account_id": "a4e4f5c1214af712b0f5f48ef7c722ec",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atria-waitlist",
      "database_id": "6e7c11bc-adbc-4cdf-a49f-43bbdddd1135",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SIGNUP_LIMITER",
      "namespace_id": "2026101901",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "public",
      "css",
      "src",
      "scripts"
    ]
  },
  "vars": {
    "CANONICAL_ORIGIN": "https://atria.atriveo.com"
  },
  "routes": [
    {
      "pattern": "atria.atriveo.com",
      "custom_domain": true
    }
  ]
}
