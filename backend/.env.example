SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-not-anon-key
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash
# MINIMAL (default) or LOW; LOW is slower.
GEMINI_THINKING_LEVEL=MINIMAL
# Set to memory to run the demo without Supabase.
ATRIA_STORE=

# Optional: Sentry tracing (backend/observability.py). Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=1.0
